{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IMP no failure count",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task description": {
            "type": "string"
          },
          "inputs needed for task": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions about the task": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "constraints on the task": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected outputs from the task": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "task description",
          "inputs needed for task",
          "assumptions about the task",
          "constraints on the task",
          "expected outputs from the task"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "tasks",
    "dependencies"
  ]
}